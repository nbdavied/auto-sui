# auto-sui 后端服务环境变量(参考模板, 安装脚本会自动生成到 /etc/auto-sui/env)
# 改完执行: systemctl restart auto-sui
#
# 本机只跑 HTTP 后端, Nginx/TLS 在另一台服务器, 故监听所有网卡供对端反代
HOST=0.0.0.0
PORT=8000
RELOAD=0

# 会话落盘: 解决 Gmail 授权中途服务重启导致授权失效
AUTOSUI_SESSION_FILE=/opt/auto-sui/sessions.db
AUTOSUI_SESSION_TTL=28800

# 公网域名(启用 Gmail 时必须, 否则 OAuth 回调会跳回本机地址)
# FRONTEND_URL=https://your.domain
# GOOGLE_REDIRECT_URI=https://your.domain/api/gmail/callback

# Gmail(境内必需代理才能连 Google)
HTTPS_PROXY=socks5://127.0.0.1:10808
HTTP_PROXY=socks5://127.0.0.1:10808
GOOGLE_TIMEOUT=15
# 若 credentials.json 不在项目根目录, 取消下面这行注释并改为实际路径
# GOOGLE_CREDENTIALS=/opt/auto-sui/credentials.json
